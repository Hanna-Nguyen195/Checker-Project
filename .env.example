# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/plagiarism_detector
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=plagiarism_detector
DATABASE_USER=username
DATABASE_PASSWORD=password

# JWT Configuration
SECRET_KEY=your-super-secret-jwt-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# MinIO Configuration
# Local development (default)
MINIO_ENDPOINT=localhost:9090
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=plagiarism-documents

# Railway MinIO Configuration (uncomment and set these when deploying to Railway)
# MINIO_ENDPOINT=your-railway-minio-endpoint.railway.app
# MINIO_ACCESS_KEY=your-railway-minio-access-key
# MINIO_SECRET_KEY=your-railway-minio-secret-key
# MINIO_BUCKET_NAME=plagiarism-documents

# Application Configuration
APP_NAME=Plagiarism Detection System
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=*

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
